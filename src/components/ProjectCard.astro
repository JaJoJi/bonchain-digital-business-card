---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Gallery from './Gallery.astro';
import type { Project } from '../lib/data';
import { profileUrls } from '../lib/social';

interface Props {
  project: Project;
  /** Show the long description (Projects page). */
  detailed?: boolean;
  index?: number;
}
const { project, detailed = false, index = 0 } = Astro.props;
const p = project.data;
const galleryId = `gallery-${project.id}`;
const logoVt = `view-transition-name: project-logo-${project.id}`;
const coverSizes = '(min-width: 1120px) 360px, (min-width: 720px) 45vw, 92vw';

const statusLabel = {
  live: 'Live',
  building: 'Building',
  research: 'Research',
  archived: 'Archived',
} as const;

const links = [
  p.links.website && { href: p.links.website, label: 'Website' },
  p.links.demo && { href: p.links.demo, label: 'Demo' },
  p.links.github && { href: p.links.github, label: 'GitHub' },
  p.links.x && { href: profileUrls.x(p.links.x), label: 'X' },
  p.links.docs && { href: p.links.docs, label: 'Docs' },
  p.links.facebook && { href: p.links.facebook, label: 'Facebook' },
].filter((l): l is { href: string; label: string } => Boolean(l));
---

<li class="card project rise" id={project.id} style={`--i:${Math.min(index, 8)}`}>
  {
    p.cover &&
      (p.gallery.length > 0 ? (
        <button
          type="button"
          class="cover-btn"
          data-gallery-open={galleryId}
          aria-label={`View ${p.gallery.length} photos from ${p.name}`}
        >
          <Image src={p.cover} alt={p.coverAlt ?? ''} widths={[400, 720, 1080]} sizes={coverSizes} class="cover" />
          <span class="photo-count" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
            {p.gallery.length} photos
          </span>
        </button>
      ) : (
        <Image src={p.cover} alt={p.coverAlt ?? ''} widths={[400, 720, 1080]} sizes={coverSizes} class="cover" />
      ))
  }
  {
    p.gallery.length > 0 && (
      <Gallery
        id={galleryId}
        title={p.name}
        photos={p.gallery}
        sourceUrl={p.links.facebook}
        sourceLabel="View the post on Facebook"
      />
    )
  }
  <div class="head">
    {
      p.logo ? (
        <Image src={p.logo} alt="" width={48} height={48} densities={[1, 2]} class="logo" style={logoVt} />
      ) : p.cover ? null : (
        <span class="logo logo-fallback" aria-hidden="true" style={logoVt}>
          {p.name.slice(0, 1)}
        </span>
      )
    }
    <div class="title">
      <h3>{p.name}</h3>
      {
        p.kind === 'event' && (
          <span class="status status-event">
            <Icon name="calendar" size={12} />
            Event
          </span>
        )
      }
      {p.status && <span class:list={['status', `status-${p.status}`]}>{statusLabel[p.status]}</span>}
    </div>
  </div>

  {
    p.awards.length > 0 && (
      <ul class="awards">
        {p.awards.map((a) => (
          <li>
            <Icon name="trophy" size={16} />
            {a.url ? (
              <a href={a.url} target="_blank" rel="noopener">
                {a.title}
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            ) : (
              <span>{a.title}</span>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <p class="summary">{p.summary}</p>
  {detailed && p.description && <p class="description">{p.description}</p>}

  {
    p.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {p.tags.map((t) => (
          <li class="chip chip-mono">{t}</li>
        ))}
      </ul>
    )
  }

  <div class="foot">
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" class="link">
                {l.label}
                <Icon name="arrow-up-right" size={14} />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .project {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    scroll-margin-top: 24px;
    overflow: hidden;
  }
  .cover {
    display: block;
    width: calc(100% + 40px);
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: -20px -20px 2px;
  }
  .cover-btn {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 0;
    width: calc(100% + 40px);
    margin: -20px -20px 2px;
  }
  .cover-btn .cover {
    width: 100%;
    margin: 0;
    transition: filter var(--dur) var(--ease);
  }
  .cover-btn:hover .cover {
    filter: brightness(1.06);
  }
  .cover-btn:focus-visible {
    outline-offset: -4px;
  }
  .photo-count {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(6 12 24 / 0.7);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .project:target {
    border-color: var(--brand);
    box-shadow:
      0 0 0 4px var(--brand-soft),
      var(--shadow-card);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .logo {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    object-fit: cover;
    flex: none;
  }
  .logo-fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--sky-2), var(--brand));
    color: #fff;
    font-weight: 700;
    font-size: 1.25rem;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }
  h3 {
    font-size: var(--text-lg);
  }
  .status {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: rgb(14 26 43 / 0.06);
    color: var(--ink-2);
  }
  .status-live {
    background: #e2f6ec;
    color: var(--success);
  }
  .status-building {
    background: var(--brand-soft);
    color: var(--brand-strong);
  }
  .status-research {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .status-event {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .awards li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: linear-gradient(90deg, #fff4e0, #fffaf2);
    color: var(--accent-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.35;
  }
  .awards li :global(svg) {
    flex: none;
    margin-top: 1px;
    color: #d98200;
  }
  .awards a {
    color: inherit;
  }
  .summary {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .description {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .tags,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot {
    margin-top: auto;
    padding-top: 4px;
  }
  .foot:empty {
    display: none;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 550;
  }
  .link:hover {
    border-color: var(--brand);
    color: var(--brand-strong);
  }
</style>
