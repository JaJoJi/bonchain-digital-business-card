const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

{
  filled[name] ? (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={className} focusable="false" {...a11y}>
      <path d={filled[name]} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      focusable="false"
      {...a11y}
      set:html={stroked[name]}
    />
  )
}
