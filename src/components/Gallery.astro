---
/**
 * Full-screen photo viewer built on the native <dialog> element.
 * Swiping uses CSS scroll-snap (no gesture library); buttons and arrow keys
 * move between photos; Esc or the close button closes it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  photos: { src: ImageMetadata; alt: string }[];
  /** Optional link to the original post. */
  sourceUrl?: string;
  sourceLabel?: string;
}
const { id, title, photos, sourceUrl, sourceLabel = 'View original post' } = Astro.props;
---

<dialog id={id} class="gallery" aria-label={`${title} photos`} data-gallery>
  <div class="top">
    <p class="title">
      <strong>{title}</strong>
      <span class="count" data-gallery-count>1 / {photos.length}</span>
    </p>
    <button type="button" class="icon-btn" data-gallery-close aria-label="Close photos">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
  </div>

  <ul class="track" data-gallery-track>
    {
      photos.map((photo, i) => (
        <li class="slide">
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[640, 1080, 1600]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </li>
      ))
    }
  </ul>

  <button type="button" class="icon-btn nav prev" data-gallery-prev aria-label="Previous photo">
    <Icon name="arrow-left" size={22} />
  </button>
  <button type="button" class="icon-btn nav next" data-gallery-next aria-label="Next photo">
    <Icon name="arrow-right" size={22} />
  </button>

  {
    sourceUrl && (
      <div class="bottom">
        <a href={sourceUrl} target="_blank" rel="noopener" class="source">
          {sourceLabel}
          <Icon name="arrow-up-right" size={16} />
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
    )
  }
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog[data-gallery]').forEach((dialog) => {
    if (dialog.dataset.ready) return;
    dialog.dataset.ready = '1';
    const track = dialog.querySelector<HTMLElement>('[data-gallery-track]')!;
    const count = dialog.querySelector<HTMLElement>('[data-gallery-count]');
    const slides = Array.from(track.children) as HTMLElement[];
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (index: number, smooth = true) => {
      const i = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: i * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    const update = () => {
      if (count) count.textContent = `${current() + 1} / ${slides.length}`;
    };

    track.addEventListener('scroll', update, { passive: true });
    dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => go(current() - 1));
    dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => go(current() + 1));
    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
    // Tap on the dark backdrop around a photo closes the viewer.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('slide')) dialog.close();
    });
    dialog.addEventListener('close', () => document.documentElement.classList.remove('gallery-open'));

    document.querySelectorAll<HTMLElement>(`[data-gallery-open="${dialog.id}"]`).forEach((opener) => {
      opener.addEventListener('click', () => {
        dialog.showModal();
        document.documentElement.classList.add('gallery-open');
        go(Number(opener.dataset.galleryIndex ?? 0), false);
        update();
      });
    });
  });
</script>

<style>
  .gallery {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(6 12 24 / 0.96);
    color: #fff;
    overflow: hidden;
  }
  .gallery::backdrop {
    background: rgb(6 12 24 / 0.9);
  }
  .gallery[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  :global(html.gallery-open) {
    overflow: hidden;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: max(10px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) 10px max(16px, env(safe-area-inset-left));
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: var(--text-sm);
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.7);
  }

  .track {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 0;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    padding: 0 8px;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    min-height: 0;
  }
  .slide :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
  }
  .icon-btn:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
  }
  .prev {
    left: max(12px, env(safe-area-inset-left));
  }
  .next {
    right: max(12px, env(safe-area-inset-right));
  }
  /* On touch screens, swiping replaces the arrow buttons. */
  @media (hover: none) and (pointer: coarse) {
    .nav {
      display: none;
    }
  }

  .bottom {
    display: flex;
    justify-content: center;
    padding: 10px 16px max(14px, env(safe-area-inset-bottom));
  }
  .source {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .source:hover {
    background: rgb(255 255 255 / 0.22);
  }
  :focus-visible {
    outline-color: #fff;
  }
</style>
