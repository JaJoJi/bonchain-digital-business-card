---
/**
 * The primary networking actions on a member card:
 *   Contact Me (Telegram, message pre-filled — the visitor presses Send)
 *   Copy message (fallback when a client ignores the pre-filled text)
 *   Save contact (.vcf)
 *   Share (native share sheet, falls back to copying the link)
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  message: string;
  telegramUrl: string | null;
  /** Used when the member has no Telegram. */
  fallback?: { href: string; label: string; icon: IconName } | null;
  vcardHref: string;
  vcardFilename: string;
  shareUrl: string;
  shareTitle: string;
}

const { message, telegramUrl, fallback, vcardHref, vcardFilename, shareUrl, shareTitle } =
  Astro.props;
---

<div class="contact" data-contact>
  {
    telegramUrl ? (
      <>
        <a class="btn btn-primary btn-lg btn-block" href={telegramUrl} rel="noopener" data-telegram>
          <Icon name="telegram" size={22} />
          <span>Contact Me</span>
        </a>
        <p class="hint">
          Opens Telegram with a message ready to send.
          <button type="button" class="btn-text" data-copy={message} data-copied-label="Message copied — paste it in Telegram">
            <Icon name="copy" />
            Copy message
          </button>
        </p>
      </>
    ) : fallback ? (
      <a
        class="btn btn-primary btn-lg btn-block"
        href={fallback.href}
        rel="noopener"
        target={fallback.href.startsWith('http') ? '_blank' : undefined}
      >
        <Icon name={fallback.icon} size={22} />
        <span>{fallback.label}</span>
      </a>
    ) : null
  }

  <div class="secondary">
    <a class="btn btn-secondary" href={vcardHref} download={vcardFilename} type="text/vcard">
      <Icon name="user-plus" />
      Save contact
    </a>
    <button type="button" class="btn btn-secondary" data-share={shareUrl} data-share-title={shareTitle}>
      <Icon name="share" />
      Share
    </button>
  </div>

  <p class="status" role="status" aria-live="polite" data-status></p>
</div>

<script>
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Older browsers / in-app webviews without the async clipboard API.
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      area.setSelectionRange(0, text.length);
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    }
  }

  function announce(root: Element, text: string) {
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (!status) return;
    status.textContent = text;
    status.classList.add('visible');
    window.clearTimeout(Number(status.dataset.timer));
    status.dataset.timer = String(
      window.setTimeout(() => {
        status.classList.remove('visible');
      }, 3200),
    );
  }

  document.querySelectorAll('[data-contact]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const ok = await copyText(button.dataset.copy ?? '');
        announce(root, ok ? (button.dataset.copiedLabel ?? 'Copied') : 'Could not copy — please copy manually.');
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
      button.addEventListener('click', async () => {
        const url = button.dataset.share ?? location.href;
        const title = button.dataset.shareTitle ?? document.title;
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (error) {
            if ((error as DOMException).name === 'AbortError') return; // user closed the sheet
          }
        }
        const ok = await copyText(url);
        announce(root, ok ? 'Link copied' : url);
      });
    });
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 12px;
  }
  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 4px;
    margin-top: -2px;
    font-size: var(--text-xs);
    color: var(--ink-3);
    text-align: center;
  }
  .hint .btn-text {
    font-size: var(--text-xs);
  }
  .secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .secondary .btn {
    padding-inline: 12px;
    white-space: nowrap;
  }
  .status {
    min-height: 0;
    margin: 0;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--success);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .status:global(.visible) {
    opacity: 1;
    transform: none;
  }
</style>
