---
/**
 * The primary networking actions on a member card:
 *   Contact Me (Telegram, message pre-filled — the visitor presses Send)
 *   Copy message (fallback when a client ignores the pre-filled text)
 *   Save contact (.vcf)
 *   Share (native share sheet, falls back to copying the link)
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  message: string;
  telegramUrl: string | null;
  /** Used when the member has no Telegram. */
  fallback?: { href: string; label: string; icon: IconName } | null;
  vcardHref: string;
  vcardFilename: string;
  shareUrl: string;
  shareTitle: string;
}

const { message, telegramUrl, fallback, vcardHref, vcardFilename, shareUrl, shareTitle } =
  Astro.props;
---

<div class="contact" data-contact>
  {
    telegramUrl ? (
      <>
        <a class="btn btn-primary btn-lg btn-block shine" href={telegramUrl} rel="noopener" data-telegram>
          <Icon name="telegram" size={22} />
          <span>Contact Me</span>
        </a>
        <p class="hint">
          Opens Telegram with a message ready to send.
          <button type="button" class="btn-text" data-copy={message} data-copied-label="Message copied — paste it in Telegram">
            <span class="swap" aria-hidden="true">
              <Icon name="copy" class="i-copy" />
              <Icon name="check" class="i-check" />
            </span>
            Copy message
          </button>
        </p>
      </>
    ) : fallback ? (
      <a
        class="btn btn-primary btn-lg btn-block"
        href={fallback.href}
        rel="noopener"
        target={fallback.href.startsWith('http') ? '_blank' : undefined}
      >
        <Icon name={fallback.icon} size={22} />
        <span>{fallback.label}</span>
      </a>
    ) : null
  }

  <div class="secondary">
    <a class="btn btn-secondary" href={vcardHref} download={vcardFilename} type="text/vcard">
      <Icon name="user-plus" />
      Save contact
    </a>
    <button type="button" class="btn btn-secondary" data-share={shareUrl} data-share-title={shareTitle}>
      <Icon name="share" />
      Share
    </button>
  </div>

  <p class="toast" role="status" aria-live="polite" data-status></p>
</div>

<script>
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Older browsers / in-app webviews without the async clipboard API.
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      area.setSelectionRange(0, text.length);
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    }
  }

  function announce(status: HTMLElement | null, text: string) {
    if (!status) return;
    status.classList.remove('visible');
    status.textContent = text;
    // Next frame so the pop-in transition replays even for repeated messages.
    requestAnimationFrame(() => requestAnimationFrame(() => status.classList.add('visible')));
    window.clearTimeout(Number(status.dataset.timer));
    status.dataset.timer = String(window.setTimeout(() => status.classList.remove('visible'), 2800));
  }

  function flashDone(button: HTMLElement) {
    button.dataset.done = '';
    window.clearTimeout(Number(button.dataset.timer));
    button.dataset.timer = String(window.setTimeout(() => delete button.dataset.done, 2000));
  }

  document.querySelectorAll('[data-contact]').forEach((root) => {
    // Fixed-position toast must live outside the card (its backdrop-filter
    // would otherwise make the card the toast's containing block).
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (status) document.body.append(status);

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const ok = await copyText(button.dataset.copy ?? '');
        if (ok) flashDone(button);
        announce(status, ok ? (button.dataset.copiedLabel ?? 'Copied') : 'Could not copy — please copy manually.');
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
      button.addEventListener('click', async () => {
        const url = button.dataset.share ?? location.href;
        const title = button.dataset.shareTitle ?? document.title;
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (error) {
            if ((error as DOMException).name === 'AbortError') return; // user closed the sheet
          }
        }
        const ok = await copyText(url);
        announce(status, ok ? 'Link copied' : url);
      });
    });
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 12px;
  }
  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 4px;
    margin-top: -2px;
    font-size: var(--text-xs);
    color: var(--ink-3);
    text-align: center;
  }
  .hint .btn-text {
    font-size: var(--text-xs);
  }
  .secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .secondary .btn {
    padding-inline: 12px;
    white-space: nowrap;
  }
  /* Copy icon turns into a check mark after copying. */
  .swap {
    position: relative;
    display: inline-grid;
    width: 18px;
    height: 18px;
  }
  .swap :global(svg) {
    grid-area: 1 / 1;
    transition:
      opacity 160ms var(--ease),
      transform 360ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .swap :global(.i-check) {
    opacity: 0;
    transform: scale(0.4) rotate(-20deg);
    color: var(--success);
  }
  [data-done] .swap :global(.i-copy) {
    opacity: 0;
    transform: scale(0.4);
  }
  [data-done] .swap :global(.i-check) {
    opacity: 1;
    transform: none;
  }

  /* A single light sweep across Contact Me shortly after the page opens. */
  .shine {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  @media (prefers-reduced-motion: no-preference) {
    .shine::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.35) 50%, transparent 70%);
      transform: translateX(-120%);
      animation: shine 1100ms var(--ease) 900ms 1 both;
      pointer-events: none;
    }
    @keyframes shine {
      to {
        transform: translateX(120%);
      }
    }
  }
</style>
