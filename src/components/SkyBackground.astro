---
/**
 * The Bonchain environment: a daylight sky, a faint network constellation
 * (nodes + links), and soft cloud banks drifting at the horizon.
 * Generated at build time from a fixed seed — no client JavaScript.
 */
interface Props {
  /** Height of the sky band. */
  height?: string;
  /** Show the network constellation. */
  network?: boolean;
}
const { height = 'min(78vh, 720px)', network = true } = Astro.props;

function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// --- Network constellation (viewBox 1440 × 720) ---
const r = rng(7);
const W = 1440;
const H = 720;
const nodes = Array.from({ length: 34 }, () => ({
  x: 40 + r() * (W - 80),
  y: 40 + r() * (H * 0.62),
  s: 1.6 + r() * 2.2,
  d: (r() * 6).toFixed(2),
}));
const edgeSet = new Set<string>();
const edges: [number, number][] = [];
nodes.forEach((a, i) => {
  nodes
    .map((b, j) => ({ j, dist: Math.hypot(a.x - b.x, a.y - b.y) }))
    .filter(({ j, dist }) => j !== i && dist < 260)
    .sort((p, q) => p.dist - q.dist)
    .slice(0, 2)
    .forEach(({ j }) => {
      const key = i < j ? `${i}-${j}` : `${j}-${i}`;
      if (!edgeSet.has(key)) {
        edgeSet.add(key);
        edges.push([i, j]);
      }
    });
});

// --- Cloud banks (each bank is 1440 wide and drawn twice for a seamless loop) ---
function cloudBank(seed: number, baseline: number, minR: number, maxR: number) {
  const rc = rng(seed);
  const puffs: { cx: number; cy: number; r: number }[] = [];
  for (let x = -60; x < W + 60; x += 70 + rc() * 70) {
    const radius = minR + rc() * (maxR - minR);
    puffs.push({ cx: x, cy: baseline - radius * (0.25 + rc() * 0.35), r: radius });
  }
  return puffs;
}
const backClouds = cloudBank(11, 250, 70, 150);
const frontClouds = cloudBank(23, 270, 50, 110);
---

<div class="sky" style={`--sky-h:${height}`} aria-hidden="true">
  {
    network && (
      <svg class="network" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice">
        <g class="links">
          {edges.map(([i, j]) => (
            <line x1={nodes[i].x.toFixed(1)} y1={nodes[i].y.toFixed(1)} x2={nodes[j].x.toFixed(1)} y2={nodes[j].y.toFixed(1)} />
          ))}
        </g>
        <g class="nodes">
          {nodes.map((n) => (
            <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={n.s.toFixed(1)} style={`animation-delay:-${n.d}s`} />
          ))}
        </g>
      </svg>
    )
  }

  <div class="clouds">
    <svg class="bank bank-back" viewBox={`0 0 ${W * 2} 300`} preserveAspectRatio="none">
      <defs>
        <radialGradient id="puff">
          <stop offset="0" stop-color="#fff" stop-opacity="0.95"></stop>
          <stop offset="0.55" stop-color="#fff" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      {[0, W].map((offset) => backClouds.map((p) => <circle cx={(p.cx + offset).toFixed(1)} cy={p.cy.toFixed(1)} r={p.r.toFixed(1)} fill="url(#puff)" />))}
    </svg>
    <svg class="bank bank-front" viewBox={`0 0 ${W * 2} 300`} preserveAspectRatio="none">
      {[0, W].map((offset) => frontClouds.map((p) => <circle cx={(p.cx + offset).toFixed(1)} cy={p.cy.toFixed(1)} r={p.r.toFixed(1)} fill="url(#puff)" />))}
    </svg>
  </div>
</div>

<style>
  .sky {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--sky-h);
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 75%, transparent);
    mask-image: linear-gradient(to bottom, #000 75%, transparent);
    background:
      radial-gradient(120% 70% at 85% 0%, rgb(255 255 255 / 0.55) 0%, transparent 60%),
      linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 42%, var(--sky-3) 72%, var(--bg) 100%);
  }

  .network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .links line {
    stroke: var(--network);
    stroke-width: 1;
    opacity: 0.16;
  }
  .nodes circle {
    fill: var(--network);
    opacity: 0.35;
    animation: twinkle 6s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% {
      opacity: 0.12;
    }
  }

  .clouds {
    position: absolute;
    inset: auto 0 0 0;
    height: 300px;
    overflow: hidden;
  }
  .bank {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 200%;
    height: 100%;
    will-change: transform;
  }
  .bank-back {
    opacity: 0.8;
    animation: drift 140s linear infinite;
  }
  .bank-front {
    bottom: -40px;
    animation: drift 90s linear infinite reverse;
  }
  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .clouds {
      height: 200px;
    }
    .bank {
      width: 400%;
    }
  }
</style>
