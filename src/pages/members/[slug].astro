---
/**
 * Member digital business card. This URL (/members/<slug>) is permanent —
 * it is what personal QR codes point to.
 */
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import ContactActions from '../../components/ContactActions.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import EventBadge from '../../components/EventBadge.astro';
import Icon from '../../components/Icon.astro';
import {
  absoluteUrl,
  contactMessageFor,
  callName,
  getMembers,
  getProjects,
  getSite,
  memberPath,
  telegramContactUrl,
  vcardPath,
  type Member,
} from '../../lib/data';
import { profileUrls } from '../../lib/social';

export async function getStaticPaths() {
  const members = await getMembers();
  return members.map((member) => ({ params: { slug: member.id }, props: { member } }));
}

interface Props {
  member: Member;
}

const { member } = Astro.props;
const m = member.data;
const site = await getSite();
const projects = await getProjects();
const message = await contactMessageFor(member);
const telegramUrl = await telegramContactUrl(member);
const first = callName(m);
const profileUrl = absoluteUrl(memberPath(member.id));

// Primary action when there is no Telegram: email, then LinkedIn.
const fallback = telegramUrl
  ? null
  : m.email
    ? {
        href: `mailto:${m.email}?body=${encodeURIComponent(message)}`,
        label: `Email ${first}`,
        icon: 'mail' as const,
      }
    : m.linkedin
      ? { href: m.linkedin, label: `Connect on LinkedIn`, icon: 'linkedin' as const }
      : null;

const ogImage = m.avatar
  ? (await getImage({ src: m.avatar, width: 600, height: 600, fit: 'cover', format: 'jpg' })).src
  : undefined;

const sameAs = [
  m.telegram && profileUrls.telegram(m.telegram),
  m.linkedin,
  m.github && profileUrls.github(m.github),
  m.x && profileUrls.x(m.x),
  m.website,
].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: m.name,
    jobTitle: m.role,
    description: m.bio ?? m.headline,
    url: profileUrl,
    image: ogImage ? absoluteUrl(ogImage) : undefined,
    worksFor: { '@type': 'Organization', name: site.name, url: absoluteUrl('/') },
    sameAs,
  },
};

const description = `${m.role} at ${site.name}. ${m.headline ?? m.bio ?? ''}`.trim();
---

<BaseLayout
  title={m.nickname ? `${m.name} (${m.nickname})` : m.name}
  description={description}
  image={ogImage}
  imageAlt={ogImage ? `Photo of ${m.name}` : undefined}
  twitterCard={ogImage ? 'summary' : 'summary_large_image'}
  ogType="profile"
  skyHeight="min(46vh, 420px)"
  jsonLd={jsonLd}
>
  <div class="container profile">
    <section class="card-glass identity rise" aria-labelledby="member-name">
      <Avatar name={m.name} src={m.avatar} size={112} eager class="photo" />
      <div class="who">
        <h1 id="member-name">{m.name}</h1>
        {
          m.nickname && (
            <p class="nick">
              Call me <strong>{m.nickname}</strong>
            </p>
          )
        }
        <p class="role">{m.role}</p>
        <p class="org">
          <span class="chip">{site.name}</span>
          {
            m.location && (
              <span class="loc">
                <Icon name="map-pin" size={14} />
                {m.location}
              </span>
            )
          }
        </p>
        {m.headline && <p class="headline">{m.headline}</p>}
      </div>

      <ContactActions
        message={message}
        telegramUrl={telegramUrl}
        fallback={fallback}
        vcardHref={vcardPath(member.id)}
        vcardFilename={`${m.name}.vcf`}
        shareUrl={profileUrl}
        shareTitle={`${m.name} · ${site.name}`}
      />

      <div class="event"><EventBadge prefix="Find me at" /></div>
    </section>

    <div class="details">
      <section aria-labelledby="links-title" class="rise" style="--i:1">
        <h2 id="links-title" class="eyebrow">Connect</h2>
        <SocialLinks member={m} />
      </section>

      {
        m.bio && (
          <section aria-labelledby="about-title" class="rise" style="--i:2">
            <h2 id="about-title" class="eyebrow">About</h2>
            <p class="bio">{m.bio}</p>
          </section>
        )
      }

      {
        projects.length > 0 && (
          <section aria-labelledby="projects-title" class="rise" style="--i:3">
            <h2 id="projects-title" class="eyebrow">Projects with the {site.name} team</h2>
            <ul class="projects">
              {projects.map((p) => (
                <li>
                  <a href={`/projects#${p.id}`} class="project">
                    {p.data.logo ? (
                      <Image src={p.data.logo} alt="" width={44} height={44} densities={[1, 2]} class="project-logo" />
                    ) : (
                      <span class="project-logo project-logo-fallback" aria-hidden="true">
                        {p.data.name.slice(0, 1)}
                      </span>
                    )}
                    <span class="project-text">
                      <span class="project-name">
                        {p.data.name}
                        {p.data.kind === 'event' && <span class="tag tag-event">Event</span>}
                      </span>
                      <span class="project-summary">{p.data.summary}</span>
                      {p.data.awards[0] && (
                        <span class="project-award">
                          <Icon name="trophy" size={14} />
                          {p.data.awards[0].title}
                        </span>
                      )}
                    </span>
                    <Icon name="arrow-right" size={18} class="project-arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <aside class="network-cta rise" style="--i:4">
        <p>
          <strong>{first} is part of the {site.name} network.</strong>
          <span class="muted"> Meet the rest of the community.</span>
        </p>
        <a href="/members" class="btn btn-secondary">
          All members
          <Icon name="arrow-right" size={18} />
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .profile {
    display: grid;
    gap: 28px;
    padding-top: clamp(8px, 4vw, 40px);
    max-width: calc(560px + 2 * var(--gutter));
  }

  /* ----- Identity card ----- */
  .identity {
    display: grid;
    gap: 20px;
    padding: 28px 20px 20px;
    text-align: center;
  }
  .identity :global(.photo) {
    justify-self: center;
    border: 4px solid #fff;
    box-shadow: 0 10px 30px -10px rgb(20 60 150 / 0.45);
  }
  .who {
    display: grid;
    gap: 6px;
    justify-items: center;
  }
  h1 {
    font-size: var(--text-2xl);
  }
  .nick {
    font-size: var(--text-sm);
    color: var(--ink-3);
    margin-top: -2px;
  }
  .nick strong {
    color: var(--brand-strong);
    font-weight: 650;
  }
  .role {
    font-size: var(--text-md);
    font-weight: 550;
    color: var(--ink-2);
  }
  .org {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 12px;
    margin-top: 2px;
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .headline {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .event {
    display: flex;
    justify-content: center;
  }

  /* ----- Details ----- */
  .details {
    display: grid;
    gap: 28px;
  }
  .details section {
    display: grid;
    gap: 12px;
  }
  .bio {
    color: var(--ink-2);
    white-space: pre-line;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .project {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }
  .project:hover {
    border-color: var(--brand);
  }
  .project-name {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tag {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
  }
  .tag-event {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .project-award {
    display: inline-flex;
    align-items: flex-start;
    gap: 6px;
    margin-top: 4px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-ink);
    line-height: 1.35;
  }
  .project-award :global(svg) {
    color: #d98200;
    flex: none;
  }
  .project-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .project-summary {
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .project :global(.project-logo) {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: cover;
    align-self: start;
    border: 1px solid var(--line);
  }
  .project-logo-fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--sky-2), var(--brand));
    color: #fff;
    font-weight: 700;
  }
  .project :global(.project-arrow) {
    color: var(--ink-3);
  }

  .network-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--brand-soft), var(--sky-3));
    font-size: var(--text-sm);
  }

  /* ----- Desktop: sticky card + content ----- */
  @media (min-width: 960px) {
    .profile {
      max-width: calc(var(--content) + 2 * var(--gutter));
      grid-template-columns: 400px 1fr;
      align-items: start;
      gap: 40px;
      padding-top: 56px;
    }
    .identity {
      position: sticky;
      top: 24px;
      padding: 36px 28px 24px;
    }
    .details {
      padding-top: 8px;
      max-width: 620px;
    }
  }
</style>
