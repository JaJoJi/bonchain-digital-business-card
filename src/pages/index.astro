---
/** Home — target of the Bonchain-level QR code. */
import BaseLayout from '../layouts/BaseLayout.astro';
import EventBadge from '../components/EventBadge.astro';
import MemberCard from '../components/MemberCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { absoluteUrl, getMembers, getProjects, getSite } from '../lib/data';

const site = await getSite();
const members = await getMembers();
const projects = (await getProjects()).slice(0, 3);
const featured = members.slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: absoluteUrl('/'),
  description: site.description,
  ...(site.origin?.url && { parentOrganization: { '@type': 'Organization', name: site.origin.name, url: site.origin.url } }),
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="rise"><EventBadge prefix="Meet us at" /></div>
    <h1 id="hero-title" class="rise" style="--i:1">
      <span class="name">{site.name}</span>
      <span class="tagline">{site.tagline}</span>
    </h1>
    <p class="intro rise" style="--i:2">{site.intro}</p>
    <div class="ctas rise" style="--i:3">
      <a href="/members" class="btn btn-primary btn-lg">
        Meet the members
        <Icon name="arrow-right" />
      </a>
      <a href="/projects" class="btn btn-secondary btn-lg">See projects</a>
    </div>
    <p class="stats rise" style="--i:4" aria-label="Network size">
      <span><strong>{members.length}</strong> members</span>
      <span aria-hidden="true">·</span>
      <span><strong>{(await getProjects()).length}</strong> projects</span>
    </p>
  </section>

  {
    featured.length > 0 && (
      <section class="container section" aria-labelledby="members-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">The network</p>
            <h2 id="members-title">Members</h2>
          </div>
          <a href="/members" class="btn-text">
            View all <Icon name="arrow-right" />
          </a>
        </div>
        <ul class="member-grid">
          {featured.map((member, i) => (
            <MemberCard member={member} index={i} />
          ))}
        </ul>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="container section" aria-labelledby="projects-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">What we build &amp; host</p>
            <h2 id="projects-title">Projects</h2>
          </div>
          <a href="/projects" class="btn-text">
            View all <Icon name="arrow-right" />
          </a>
        </div>
        <ul class="project-grid">
          {projects.map((project, i) => (
            <ProjectCard project={project} index={i} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="container section" aria-labelledby="about-title">
    <div class="about card">
      <div class="about-text">
        <p class="eyebrow">About</p>
        <h2 id="about-title">From the cloud, across the network</h2>
        {site.about[0] && <p class="muted">{site.about[0]}</p>}
        <a href="/about" class="btn btn-secondary">
          About {site.name}
          <Icon name="arrow-right" />
        </a>
      </div>
      {
        site.focus.length > 0 && (
          <ul class="focus">
            {site.focus.map((f, i) => (
              <li>
                <span class="node" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{f.title}</h3>
                  <p class="muted">{f.text}</p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-top: clamp(32px, 10vw, 120px);
    padding-bottom: clamp(32px, 7vw, 96px);
  }
  h1 {
    display: grid;
    gap: 8px;
  }
  .name {
    font-size: var(--text-hero);
    letter-spacing: -0.045em;
    font-weight: 700;
    line-height: 0.95;
  }
  .tagline {
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: -0.02em;
  }
  .intro {
    max-width: 54ch;
    font-size: var(--text-md);
    color: var(--ink-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }
  .stats {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
  .stats strong {
    color: var(--ink);
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
  }

  .about {
    display: grid;
    gap: 32px;
    padding: clamp(24px, 4vw, 48px);
    background:
      radial-gradient(80% 120% at 100% 0%, var(--sky-3) 0%, transparent 60%),
      var(--surface);
  }
  .about-text {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .about-text h2 {
    font-size: var(--text-xl);
  }
  .focus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    position: relative;
  }
  .focus li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    position: relative;
  }
  /* Thin connector between the focus "nodes". */
  .focus li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 42px;
    bottom: -18px;
    width: 1px;
    background: linear-gradient(var(--brand), transparent);
    opacity: 0.35;
  }
  .node {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .focus h3 {
    font-size: var(--text-md);
    margin-bottom: 2px;
  }
  .focus p {
    font-size: var(--text-sm);
  }

  @media (min-width: 860px) {
    .about {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 56px;
    }
  }
</style>
